#!/usr/bin/env bash

WALLPAPER_PATH="~/Pictures/dark_ivy.png"

check_dependency() {
  if [ "$#" -eq 1 ]; then
    command -v "$1" 2> /dev/null
  fi
}

if [ ! -z $(check_dependency polybar) ]; then
  pgrep -x polybar > /dev/null || polybar &
else
  notify-send "bspwmrc\nNo polybar"
fi

if [ ! -z $(check_dependency sxhkd) ]; then
  pgrep -x sxhkd > /dev/null || sxhkd &
else
  notify-send "bspwmrc\nNo sxhkd"
fi

if [ ! -z $(check_dependency xwallpaper) ]; then
  pgrep -x xwallpaper > /dev/null || xwallpaper --stretch "${WALLPAPER_PATH}" &
else
  notify-send "bspwmrc\nNo xwallpaper"
fi

if [ ! -z $(check_dependency xcompmgr) ]; then
  pgrep -x xcompmgr > /dev/null || xcompmgr &
else
  notify-send "bspwmrc\nNo xcompmgr"
fi


bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width 2
bspc config window_gap 5

bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle false

bspc config normal_border_color "#000000"
bspc config focused_border_color "#ffffff"
